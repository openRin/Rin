# Rin 本地开发配置
# 复制此文件为 .env.local 并填入你的实际配置

# ============================================
# 站点配置（可选，默认值如下）
# 注意：这些配置可以在部署后通过设置页面修改
# 配置优先级：设置页面 > 环境变量 > 默认值
# ============================================

# 网站基本信息（默认：Rin）
# NAME=Rin

# 网站描述（默认：A lightweight personal blogging system）
# DESCRIPTION=A lightweight personal blogging system

# 头像地址（默认：空）
# AVATAR=

# 分页大小（默认：5）
# PAGE_SIZE=5

# RSS 设置（默认：false）
# RSS_ENABLE=false

# ============================================
# 后端配置 (wrangler.toml 中的 vars)
# ============================================
BACKEND_PORT=11498

# ============================================
# 对象存储后端（三选一，删掉用不上的那组）
#   r2       : Cloudflare R2 binding（需R2_BUCKET_NAME）
#   s3       : 任意 S3 兼容服务（R2 S3 API / MinIO / AWS S3）
#   supabase : Supabase Storage
# 留空时自动探测：配了 Supabase → supabase，有 R2_BUCKET_NAME → r2，否则 s3
# ============================================

# ---------- 方案A：Supabase Storage ----------
# 四项【全部必填】，缺任何一项启动都会报 XXX is not defined
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_STORAGE_BUCKET=rin
# 高权限 key，绕过 RLS，可读写私有 bucket。部署时作为加密 Secret 注入。
# 新版与旧版二选一填入即可，代码按key 形态自动适配：
#   sb_secret_...                ← 推荐（Supabase 控制台 → API → Secret keys）
#   eyJ...（legacy service_role JWT）  ← Project Settings → API → Legacy keys
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# bucket 是否为公开桶：
#   true  → 图片由 Supabase CDN 直接对外服务（推荐，性能更好）
#   false → 私有桶，图片经 Worker /api/blob 反代（高权限 key 绕过 RLS）
SUPABASE_STORAGE_PUBLIC=true

# ---------- 方案 B：S3 兼容存储 ----------
# 后端为 s3 或 r2 时使用，改用上面把 STORAGE_PROVIDER 设为 s3 或 r2
S3_FOLDER=images/
S3_CACHE_FOLDER=cache/
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_HOST=https://your-image-domain.com
S3_BUCKET=your-bucket-name
S3_FORCE_PATH_STYLE=false
# 上面四项 S3 凭证仅 s3 后端需要（R2 binding 自带凭证，无需填写）：
# S3_ACCESS_KEY_ID=your-s3-access-key
# S3_SECRET_ACCESS_KEY=your-s3-secret-key

# 缓存存储模式配置
# s3: 使用 S3 存储缓存（默认，向前兼容）
# database: 使用数据库存储缓存（推荐，开箱即用）
CACHE_STORAGE_MODE=database

# Webhook 通知地址（可选）
WEBHOOK_URL=

# RSS 标题和描述
RSS_TITLE=Rin Development
RSS_DESCRIPTION=Development Environment

# 站点公开访问地址（可选）
# 用于生成 sitemap.xml / robots.txt 中的绝对链接；留空时自动回退到请求来源
# FRONTEND_URL=https://your-domain.com

# ============================================
# 敏感配置（会被加密存储）
# ============================================
# GitHub OAuth 配置（可选，如果不配置则只能使用账号密码登录）
RIN_GITHUB_CLIENT_ID=
RIN_GITHUB_CLIENT_SECRET=

# 管理员账号密码（用于账号密码登录，如果不配置 GitHub OAuth 则必须设置）
# 默认账号: admin
# 默认密码: admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 密钥
JWT_SECRET=your-jwt-secret-key

# 注：对象存储凭证（S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY /
# SUPABASE_SECRET_KEY）统一写在上面的「对象存储后端」一节，
# 且会按后端类型分别注入 Secret，无需在此重复配置。

# ============================================
# Cloudflare Turnstile 人机验证（可选）
# ============================================
# 用于评论与邮箱注册防机器人。**不配置则该功能整体关闭**，
# 不会进入「前端弹验证码但服务端放行」的半可用状态。
#
# ── 获取 key ──────────────────────────────────────────
#   1. 打开 https://dash.cloudflare.com/?to=/:account/turnstile
#      切换到你的账号，点「Add widget」
#   2. 名称随意，例如 rin
#   3. Widget 模式建议选 **Managed**（最省心，Cloudflare 自动判定是否要出题）
#      - Invisible：仅可疑流量出题
#      - Managed：按风险决定（推荐）
#      - Non-interactive / Interactive：始终或多数出题
#   4. 域名白名单：把你的站点域名加进去，如 example.com
#      ——**本地开发要额外加 localhost 与 127.0.0.1**
#      ——不加会表现为「widget 一直转圈不出题」
#   5. 创建后拿到两个 key：
#        Site Key   → 公开，会下发到浏览器
#        Secret Key → 机密，用于服务端 siteverify 校验
#
# ── 填法 ──────────────────────────────────────────────
#   TURNSTILE_ENABLED  是否启用。填 true 即开启。
#                      留空时以后台「服务器配置」的 turnstile.enabled 为准。
#   TURNSTILE_SITE_KEY   公开值，走 wrangler vars
#   TURNSTILE_SECRET_KEY 机密，走 wrangler secret
#
# ── 注意 ──────────────────────────────────────────────
#   三项必须齐全才会真正生效。缺 secret key 时服务端会强制关闭，
#   因为「只有 site key、无法 siteverify」等于前端弹验证码但后端放行。
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=0x4AAAAAAAXXXXXXXXXXXXXXXX
TURNSTILE_SECRET_KEY=0x4AAAAAAAXXXXXXXXXXXXXXXX

# ── 验证范围（可选，一般不用改）────────────────────────
#   在后台「服务器配置」里设置 turnstile.scope：
#     guest（默认）只要求未登录用户验证，登录用户跳过
#     all             所有人都要验证
#   未设置时按 guest 处理。

# ============================================
# 邮件发送（可选，邮箱注册的前提）
# ============================================
# 三种 Provider 任选其一。**留空则邮箱注册功能关闭。**
#
#   smtp    : 直连 SMTP，需要 SMTP_HOST/USERNAME/PASSWORD/FROM
#   resend  : Resend HTTP API，需要 RESEND_API_KEY + 发件人
#   custom  : 自建 HTTP 邮件网关（见 docs/mail-gateway-worker.js）
#
# 不填 MAIL_PROVIDER 时会自动探测：配了 RESEND_API_KEY 用 resend，
# 其次有 MAIL_GATEWAY_ENDPOINT 用 custom，最后回落到 smtp。
MAIL_PROVIDER=

# ---------- 方案 A：SMTP 直连 ----------
# 加密模式：
#   465 → 自动使用隐式 TLS（tlsMode = implicit）
#   587 → 自动使用 STARTTLS（tlsMode = starttls）
# 端口填 465 或 587 即可，程序会自动判断，无需手动指定 tlsMode。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人地址。多数服务商要求与 SMTP_USERNAME 一致，否则会被拒收。
SMTP_FROM=

# ---------- 方案 B：Resend ----------
# 最省事的一种：只需一个 API key + 一个已验证域名的发件人。
# 端点默认 https://api.resend.com/emails，如需走代理可覆盖 RESEND_ENDPOINT。
RESEND_API_KEY=
RESEND_ENDPOINT=
# Resend 必填发件人（需已在 Resend 后台验证过域名）
SMTP_FROM=

# ---------- 方案 C：自定义 HTTP 邮件网关 ----------
# 适合：已有自建邮件 Worker，或用不上 Workers 出站 SMTP 的场景。
# 网关实现见 docs/mail-gateway-worker.js，接口契约：
#   POST {endpoint}，请求体 { from?, to, subject, text, html? }
#   响应 { ok: boolean, error?: string }
MAIL_GATEWAY_ENDPOINT=

# 鉴权方式二选一（JWT 推荐，静态 token 备选）：

# 【推荐】JWT 模式：主站每次请求现签一个 60 秒有效的短期 token。
# 网关会校验签名 + aud + purpose + exp 四项。
#
#   重要：MAIL_JWT_SECRET 两侧必须填**同一个值**。
#   生成方法：openssl rand -base64 32
#   建议单独取一个值，不要直接复用 JWT_SECRET ——
#   共享密钥会让网关持有伪造主站用户身份的能力。
MAIL_JWT_SECRET=

# 【备选】静态 token 模式：网关与主站共享一个固定字符串。
# 注意：填了 MAIL_GATEWAY_TOKEN 就优先用它，JWT 模式不再生效。
# MAIL_GATEWAY_TOKEN=

# 鉴权头与值模板，默认 Authorization + "Bearer {token}"
# 网关用 X-Mail-Token 时改成：X-Mail-Token 与 "{token}"
MAIL_GATEWAY_AUTH_HEADER=Authorization
MAIL_GATEWAY_AUTH_TEMPLATE=Bearer {token}
# 网关侧字段名不一致时可逐项覆盖，默认与标准同名
MAIL_GATEWAY_TO_FIELD=
MAIL_GATEWAY_SUBJECT_FIELD=
MAIL_GATEWAY_TEXT_FIELD=
MAIL_GATEWAY_HTML_FIELD=
MAIL_GATEWAY_FROM_FIELD=

# ---------- 通用邮件选项 ----------
# 统一发件人地址。各 provider 未单独配置时的兜底。
MAIL_FROM=
# 投递超时（毫秒），默认 15000
MAIL_TIMEOUT_MS=

# 邮箱注册总开关（默认 true）
# 置 false 可在 SMTP/网关配置不变的情况下临时关闭注册。
REGISTER_ENABLED=true

# 注：以上所有能力都是可选的。留空对应功能自动关闭，
# 站点仍可正常运行（只是没有邮箱注册 / 没有人机验证）。

# ============================================
# 数据库配置
# ============================================
DB_NAME=rin
